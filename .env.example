# OpenAI-compatible endpoint used for summarising and translating.
# Copy this file to .env and paste the value from your other project.
OPENCODE_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=kimi-k2.5

# Hokkien TTS provider. Fill in once the provider is chosen.
# HOKKIEN_TTS_API_KEY=
