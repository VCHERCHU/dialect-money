# One key, two consumers. The chat assistant (server/app.py) and the explainer
# pipeline (run.py) both talk to the same OpenAI-compatible endpoint, but they
# read differently-named variables. Both sets are kept here rather than one being
# renamed to match the other, because renaming either would silently break the
# code that reads it. Worth unifying deliberately, not as a merge side effect.
#
# Copy this file to .env and paste your key.

OPENCODE_API_KEY=sk-your-key-here

# Chat assistant — server/app.py
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=glm-5.3-flash

# Explainer pipeline — run.py
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=kimi-k2.5

# Hokkien TTS provider. Fill in once the provider is chosen.
# HOKKIEN_TTS_API_KEY=
